---
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactDock from '../components/ContactDock.astro';
import { site } from '../config/site';
const { title, description = site.description } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).toString();
---
<!doctype html>
<html lang="pl">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#efeeea" />
    <meta property="og:type" content="website" /><meta property="og:locale" content="pl_PL" />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:url" content={canonical} />
    <link rel="canonical" href={canonical} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <title>{title}</title>
    <script type="application/ld+json">__JSON_LD__</script>
  </head>
  <body><Header /><main id="main"><slot /></main><Footer /><ContactDock /><script src="/scripts/site.js" defer></script></body>
</html>
