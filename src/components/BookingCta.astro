---
import MessengerButton from './MessengerButton.astro';
import { site } from '../config/site';
interface Props { title?: string; }
const { title = 'Porozmawiajmy o Waszym pobycie' } = Astro.props;
---
<section class="booking-cta">
  <div class="container booking-inner">
    <div class="booking-copy">
      <span class="eyebrow">Zaplanujcie pobyt</span>
      <h2>{title}</h2>
      <p>Napiszcie, kiedy chcecie przyjechać i ile osób będzie z Wami. Ustalimy wolny termin, cenę i wszystko, co warto wiedzieć przed przyjazdem.</p>
    </div>
    <div class="booking-actions">
      <MessengerButton variant="light" />
      <a class="phone-link" href={site.phoneHref}>Możecie też zadzwonić: {site.phone}</a>
    </div>
  </div>
</section>
<style>
  .booking-cta{padding-block:var(--space-12);background:var(--color-forest);color:var(--color-white)}
  .booking-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-8)}
  .booking-copy{max-width:640px}
  .eyebrow{color:var(--color-muted-on-forest)}
  h2{margin:var(--space-2) 0 var(--space-3);font-size:clamp(1.8rem,4vw,2.5rem)}
  p{margin:0;color:var(--color-muted-on-forest)}
  .booking-actions{display:flex;flex-shrink:0;flex-direction:column;align-items:center;gap:var(--space-2)}
  .phone-link{display:inline-flex;min-height:44px;align-items:center;color:var(--color-white);font-size:.85rem;text-align:center;text-underline-offset:4px}
  @media(max-width:850px){.booking-inner{align-items:flex-start;flex-direction:column}.booking-actions{align-items:flex-start;max-width:100%}}
</style>
