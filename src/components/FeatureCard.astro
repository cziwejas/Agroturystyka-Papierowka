---
import Icon from './Icon.astro';
const { icon, title, text } = Astro.props;
---
<article class="card"><span class="icon"><Icon name={icon} /></span><h3>{title}</h3><p>{text}</p></article>
<style>.card{height:100%;padding:1.6rem;background:#fff;border-radius:var(--radius);box-shadow:var(--shadow)}.icon{display:grid;place-items:center;width:58px;height:58px;background:#f7eee7;color:#ba4214;border-radius:18px;margin-bottom:1.2rem}.card h3{margin-bottom:.55rem}.card p{color:var(--muted);margin:0}</style>
