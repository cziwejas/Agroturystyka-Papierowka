---
import { site } from '../config/site';

interface Props {
  label?: string;
  variant?: 'default' | 'light';
}

const { label = 'Napisz na Facebooku', variant = 'default' } = Astro.props;
---
<a class:list={['messenger-button', { 'messenger-button--light': variant === 'light' }]} href={site.socialLinks.facebook} target="_blank" rel="noopener noreferrer">
  <svg aria-hidden="true" focusable="false" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7" stroke-linecap="round" stroke-linejoin="round"><path d="M21 11.5a8.4 8.4 0 0 1-.9 3.8 8.5 8.5 0 0 1-7.6 4.7 8.4 8.4 0 0 1-3.8-.9L3 21l1.9-5.7a8.4 8.4 0 0 1-.9-3.8 8.5 8.5 0 0 1 4.7-7.6 8.4 8.4 0 0 1 3.8-.9h.5a8.5 8.5 0 0 1 8 8v.5Z"/><path d="M8 11h8m-8 4h5"/></svg>
  <span>{label}</span>
</a>
<style>
  .messenger-button{display:inline-flex;max-width:100%;min-height:48px;align-items:center;justify-content:center;gap:var(--space-3);padding:var(--space-3) var(--space-6);border:1px solid transparent;border-radius:var(--radius-pill);background:var(--color-forest-dark);color:var(--color-white);font-weight:700;line-height:1.5;text-align:center;text-decoration:none;transition:background .2s ease,transform .2s ease}
  .messenger-button svg{flex-shrink:0}
  .messenger-button:hover{transform:translateY(-2px);background:var(--color-forest)}
  .messenger-button--light{background:var(--color-white);color:var(--color-ink)}
  .messenger-button--light:hover{background:var(--color-paper)}
</style>
