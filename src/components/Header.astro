---
import { site } from '../config/site';
const path = Astro.url.pathname;
const nav = [{ label: 'Strona główna', href: '/' }, { label: 'O nas', href: '/o-nas/' }, { label: 'Galeria', href: '/galeria/' }, { label: 'Kontakt', href: '/kontakt/' }];
---
<a class="skip-link" href="#main">Przejdź do treści</a>
<div class="topline"><div class="container topline-inner"><span>Spokojny wypoczynek na Podlasiu</span><a href={site.phoneHref}>Zadzwoń: {site.phone}</a></div></div>
<header class="header">
  <div class="container nav-wrap"><a class="brand" href="/" aria-label="Papierówka — strona główna"><span class="brand-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"/><path d="M12 22v-3"/></svg></span><span>Papierówka<small>agroturystyka</small></span></a>
    <button class="menu-toggle" type="button" aria-expanded="false" aria-controls="main-nav"><span class="sr-only">Otwórz menu</span><span></span><span></span><span></span></button>
    <nav id="main-nav" aria-label="Główna nawigacja"><ul>{nav.map((item) => <li><a href={item.href} aria-current={path === item.href ? 'page' : undefined}>{item.label}</a></li>)}</ul></nav>
  </div>
</header>
<style>
  .topline{background:var(--color-forest-dark);color:var(--color-muted-on-forest);font-size:.84rem}.topline-inner{display:flex;min-height:38px;align-items:center;justify-content:space-between;gap:var(--space-4)}.topline a{color:var(--color-white);font-size:.92rem;font-weight:600;font-variant-numeric:tabular-nums;letter-spacing:.04em;text-decoration:none}.topline a:hover{color:var(--color-hero-eyebrow);text-decoration:underline;text-underline-offset:3px}
  .header{position:sticky;top:0;z-index:20;background:var(--color-white);box-shadow:var(--shadow-nav)}.nav-wrap{position:relative;display:flex;min-height:78px;align-items:center;justify-content:space-between;gap:var(--space-4)}.brand{display:flex;align-items:center;gap:var(--space-3);font-size:1.25rem;font-weight:700;text-decoration:none}.brand small{display:block;color:var(--color-muted);font-size:.65rem;font-weight:600;letter-spacing:.14em;text-transform:uppercase}.brand-mark{display:grid;width:46px;height:46px;place-items:center;border-radius:50%;background:var(--color-forest-dark);color:var(--color-white)}
  .nav-wrap ul{display:flex;gap:clamp(var(--space-4),3vw,var(--space-8));margin:0;padding:0;list-style:none}.nav-wrap nav a{position:relative;display:inline-flex;min-height:44px;align-items:center;font-size:.93rem;font-weight:700;text-decoration:none}.nav-wrap nav a::after{position:absolute;right:0;bottom:5px;left:0;height:2px;background:var(--color-forest-dark);content:'';transform:scaleX(0);transform-origin:left;transition:transform .2s ease}.nav-wrap nav a:hover::after,.nav-wrap nav a[aria-current=page]::after{transform:scaleX(1)}
  .menu-toggle{display:none;width:46px;height:46px;align-items:center;justify-content:center;border:1px solid var(--color-line);border-radius:50%;background:var(--color-white);cursor:pointer}.menu-toggle span:not(.sr-only){display:block;width:20px;height:2px;margin:4px 0;background:var(--color-ink)}.menu-toggle span.sr-only{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0,0,0,0);white-space:nowrap}
  @media(max-width:700px){.topline-inner{min-height:36px;justify-content:center}.topline-inner>span{display:none}.nav-wrap{min-height:72px}.nav-wrap ul{display:grid;gap:var(--space-1)}.nav-wrap nav a{display:flex;padding:var(--space-3);border-radius:var(--space-2)}.nav-wrap nav a:hover,.nav-wrap nav a[aria-current=page]{background:var(--color-soft)}.nav-wrap nav a::after{display:none}:global(.js) .menu-toggle{display:flex;flex-direction:column}:global(.js) .nav-wrap nav{position:absolute;top:calc(100% + var(--space-2));right:0;left:0;z-index:5;display:none;padding:var(--space-3);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}:global(.js) .nav-wrap nav[data-open="true"]{display:block}}
</style>
