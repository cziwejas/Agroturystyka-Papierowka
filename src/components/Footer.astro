---
import { site } from '../config/site';
---
<footer class="footer"><div class="container footer-grid"><div><a class="footer-brand" href="/"><span class="footer-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"/><path d="M12 22v-3"/></svg></span>Papierówka</a><p>Wytchnienie wśród podlaskiej przyrody.</p></div><div><strong>Kontakt</strong><p><a href={site.phoneHref}>{site.phone}</a><br/><a href="/kontakt/">Napisz do nas</a></p></div><div><strong>Adres</strong><p>{site.address}<br/>{site.postalCode} {site.addressLocality}<br/>województwo podlaskie</p></div><div><strong>Informacje</strong><p><a href="/polityka-prywatnosci/">Polityka prywatności</a><br/><a href="/o-nas/">O nas</a></p></div></div><div class="container copyright">© {new Date().getFullYear()} Agroturystyka Papierówka · Wasilkowo, Podlaskie</div></footer>
<style>.footer{padding:var(--space-16) 0 var(--space-5);background:var(--color-footer);color:var(--color-paper)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr 1fr;gap:var(--space-8)}.footer a{color:var(--color-white);text-underline-offset:4px}.footer a:hover{color:var(--color-footer-hover)}.footer-brand{display:inline-flex;align-items:center;gap:var(--space-3);font:700 1.6rem 'Raleway',sans-serif;text-decoration:none}.footer-mark{display:grid;width:40px;height:40px;place-items:center;border-radius:50%;background:var(--color-forest-dark);color:var(--color-white)}.footer p{color:var(--color-footer-muted)}.copyright{margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--color-footer-divider);color:var(--color-footer-muted);font-size:.83rem}@media(max-width:650px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}</style>
