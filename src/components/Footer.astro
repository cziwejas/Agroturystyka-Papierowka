---
import { site } from '../config/site';
---
<footer class="footer"><div class="container footer-grid"><div><a class="footer-brand" href="/">Papierówka</a><p>Wytchnienie wśród podlaskiej przyrody.</p></div><div><strong>Kontakt</strong><p><a href={site.phoneHref}>{site.phone}</a><br/><a href="/kontakt/">Napisz do nas</a></p></div><div><strong>Informacje</strong><p><a href="/polityka-prywatnosci/">Polityka prywatności</a><br/><a href="/o-nas/">O nas</a></p></div></div><div class="container copyright">© {new Date().getFullYear()} Papierówka · Wasilkowo, Podlaskie</div></footer>
<style>.footer{background:#262a23;color:#f7f5ef;padding:54px 0 20px}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:2rem}.footer a{color:#fff}.footer-brand{font:700 1.6rem 'Raleway',sans-serif;text-decoration:none}.footer p{color:#c4c6bd}.copyright{border-top:1px solid #ffffff25;margin-top:35px;padding-top:16px;color:#c4c6bd;font-size:.83rem}@media(max-width:650px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}</style>
