---
import { site } from '../config/site';
import SocialLinks from './SocialLinks.astro';
---
<footer class="footer"><div class="container footer-grid"><div><a class="footer-brand" href="/"><span class="footer-mark" aria-hidden="true"><svg xmlns="http://www.w3.org/2000/svg" width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="m17 14 3 3.3a1 1 0 0 1-.7 1.7H4.7a1 1 0 0 1-.7-1.7L7 14h-.3a1 1 0 0 1-.7-1.7L9 9h-.2A1 1 0 0 1 8 7.3L12 3l4 4.3a1 1 0 0 1-.8 1.7H15l3 3.3a1 1 0 0 1-.7 1.7H17Z"/><path d="M12 22v-3"/></svg></span>Papierówka</a><p>Wytchnienie wśród podlaskiej przyrody.</p></div><div><strong>Kontakt</strong><p><a href={site.phoneHref}>{site.phone}</a><br/><a href="/kontakt/">Napisz do nas</a></p></div><div><strong>Adres</strong><p>{site.address}<br/>{site.postalCode} {site.addressLocality}<br/>województwo podlaskie</p></div><div><strong>Informacje</strong><p><a href="/polityka-prywatnosci/">Polityka prywatności</a><br/><a href="/o-nas/">O nas</a></p></div><div class="socials"><strong>Znajdź nas</strong><SocialLinks /></div></div><div class="container copyright">© {new Date().getFullYear()} Agroturystyka Papierówka · Wasilkowo, Podlaskie</div></footer>
<style>.footer{padding:var(--space-16) 0 var(--space-5);background:var(--color-footer);color:var(--color-paper)}.footer-grid{display:grid;grid-template-columns:2fr repeat(4,1fr);gap:var(--space-8)}.footer a{color:var(--color-white);text-underline-offset:4px}.footer a:hover{color:var(--color-footer-hover)}.footer-brand{display:inline-flex;align-items:center;gap:var(--space-3);font:700 1.6rem 'Raleway',sans-serif;text-decoration:none}.footer-mark{display:grid;width:40px;height:40px;place-items:center;border-radius:50%;background:var(--color-forest-dark);color:var(--color-white)}.footer p{color:var(--color-footer-muted)}.socials>strong{display:block;margin-bottom:var(--space-3)}.social-links{display:flex;gap:var(--space-2)}.social-links a{display:grid;width:40px;height:40px;place-items:center;border:1px solid var(--color-footer-divider);border-radius:50%;background:#ffffff0a;transition:background .2s ease,transform .2s ease}.social-links a:hover{background:#ffffff20;transform:translateY(-2px)}.social-links svg{width:21px;height:21px;fill:currentColor}.social-links a:nth-child(1) svg{fill:#1877f2}.social-links a:nth-child(2) svg{fill:none;stroke:#e1306c;stroke-width:1.8}.social-links a:nth-child(2) .social-dot{fill:#e1306c;stroke:none}.social-links a:nth-child(3) svg{width:24px;height:24px;fill:initial}.copyright{margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--color-footer-divider);color:var(--color-footer-muted);font-size:.83rem}@media(max-width:900px){.footer-grid{grid-template-columns:repeat(3,1fr)}.footer-grid>div:first-child{grid-column:1/-1}}@media(max-width:650px){.footer-grid{grid-template-columns:1fr 1fr;gap:var(--space-6)}.footer-grid>div:first-child{grid-column:1/-1}}</style>
