---
import { site } from '../config/site';
---
<footer class="footer"><div class="container footer-grid"><div><a class="footer-brand" href="/">Papierówka</a><p>Wytchnienie wśród podlaskiej przyrody.</p></div><div><strong>Kontakt</strong><p><a href={site.phoneHref}>{site.phone}</a><br/><a href="/kontakt/">Napisz do nas</a></p></div><div><strong>Informacje</strong><p><a href="/polityka-prywatnosci/">Polityka prywatności</a><br/><a href="/o-nas/">O nas</a></p></div></div><div class="container copyright">© {new Date().getFullYear()} Papierówka · Wasilkowo, Podlaskie</div></footer>
<style>.footer{padding:var(--space-16) 0 var(--space-5);background:var(--color-footer);color:var(--color-paper)}.footer-grid{display:grid;grid-template-columns:2fr 1fr 1fr;gap:var(--space-8)}.footer a{color:var(--color-white);text-underline-offset:4px}.footer a:hover{color:var(--color-footer-hover)}.footer-brand{font:700 1.6rem 'Raleway',sans-serif;text-decoration:none}.footer p{color:var(--color-footer-muted)}.copyright{margin-top:var(--space-8);padding-top:var(--space-4);border-top:1px solid var(--color-footer-divider);color:var(--color-footer-muted);font-size:.83rem}@media(max-width:650px){.footer-grid{grid-template-columns:1fr 1fr}.footer-grid>div:first-child{grid-column:1/-1}}</style>
