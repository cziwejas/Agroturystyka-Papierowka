---
import { Image } from 'astro:assets';
import outside from '../assets/img/zewnatrz.jpg';
import gazebo from '../assets/img/altana.jpg';
import firepit from '../assets/img/altana-wieczorem.jpg';
import living from '../assets/img/salon.jpg';
import entry from '../assets/img/wnetrze.jpg';
import jacuzzi from '../assets/img/jacuzzi.jpg';
const pictures = [
  { src: outside, alt: 'Dom agroturystyczny otoczony zielenią', title: 'Dom i okolica' },
  { src: gazebo, alt: 'Drewniana altana z miejscem do wypoczynku', title: 'Altana' },
  { src: firepit, alt: 'Wieczorny wypoczynek przy palenisku pod altaną', title: 'Wieczory przy ogniu' },
  { src: living, alt: 'Przytulny salon z drewnianymi elementami', title: 'Wnętrza' },
  { src: entry, alt: 'Drewniane wnętrze domu', title: 'Domowe ciepło' },
  { src: jacuzzi, alt: 'Bania ogrodowa przy drewnianym domu', title: 'Strefa relaksu' },
];
---
<div class="gallery">{pictures.map((picture) => <a class="tile" href={picture.src.src} data-lightbox data-alt={picture.alt} data-caption={picture.title}><Image src={picture.src} alt={picture.alt} widths={[480, 720, 960, 1200]} sizes="(max-width: 700px) 100vw, 33vw" format="webp" loading="lazy"/><span>{picture.title}</span></a>)}</div>
<dialog id="lightbox" aria-label="Podgląd zdjęcia"><button class="close" type="button" data-close aria-label="Zamknij podgląd">×</button><button class="previous" type="button" data-previous aria-label="Poprzedni obraz">‹</button><figure><img src="" alt=""/><figcaption></figcaption></figure><button class="next" type="button" data-next aria-label="Następny obraz">›</button></dialog>
<style>
  .gallery{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4)}
  .tile{position:relative;display:block;overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius-card);background:var(--color-soft)}
  .tile img{display:block;width:100%;height:100%;object-fit:cover;transition:transform .22s ease}
  .tile:hover img{transform:scale(1.025)}
  .tile span{position:absolute;inset:auto 0 0;padding:var(--space-10) var(--space-4) var(--space-4);background:linear-gradient(transparent,var(--color-gallery-overlay));color:var(--color-white);font-weight:700}
  dialog{position:fixed;inset:0;max-width:min(94vw,1000px);max-height:92vh;margin:auto;padding:var(--space-12) var(--space-12) var(--space-6);border:0;border-radius:var(--radius-card);background:var(--color-footer);color:var(--color-white)}
  dialog::backdrop{background:var(--color-dialog-backdrop)}dialog figure{margin:0}dialog img{display:block;max-width:100%;max-height:72vh;margin:auto;object-fit:contain}figcaption{padding-top:var(--space-3);text-align:center}
  .close,.previous,.next{position:absolute;display:grid;width:46px;height:46px;place-items:center;border:1px solid var(--color-line);border-radius:50%;background:var(--color-white);color:var(--color-ink);font-size:1.8rem;cursor:pointer}
  .close{top:var(--space-3);right:var(--space-3)}.previous{top:50%;left:var(--space-3)}.next{top:50%;right:var(--space-3)}
  @media(max-width:850px){.gallery{grid-template-columns:repeat(2,minmax(0,1fr))}}
  @media(max-width:560px){.gallery{grid-template-columns:1fr}.tile{aspect-ratio:3/2}dialog{padding:var(--space-12) var(--space-10) var(--space-5)}.previous{left:var(--space-1)}.next{right:var(--space-1)}}
</style>
