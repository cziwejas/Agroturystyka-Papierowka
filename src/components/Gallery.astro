---
import { getImage } from 'astro:assets';
import NatureGallery from './NatureGallery.astro';
import galleryScriptUrl from '../scripts/nature-gallery.js?url&no-inline';
import outside from '../assets/img/zewnatrz.jpg';
import gazebo from '../assets/img/altana.jpg';
import gazebo1 from '../assets/img/altana1.jpg';
import living from '../assets/img/salon.jpg';
import entry from '../assets/img/wnetrze.jpg';
import fireplace from '../assets/img/Papierówka_015.jpg';
import lounge from '../assets/img/Papierówka_022.jpg';
import houseSpring from '../assets/img/new_imgs/9AGnXCNt.jpg';
import houseFront from '../assets/img/new_imgs/NLGm7_T-.jpg';
import cosyDetails from '../assets/img/new_imgs/ZsaI_v2N.jpg';
import pool from '../assets/img/new_imgs/8grxGd3g.jpg';
import apples from '../assets/img/new_imgs/XdRRhm98.jpg';
import playground from '../assets/img/new_imgs/au7F72FT.jpg';
import autumnTrail from '../assets/img/new_imgs/W6Vv7SrF.jpg';
import greenTrail from '../assets/img/new_imgs/chf_cCke.jpg';
import forestStream from '../assets/img/new_imgs/7_pSdH2p.jpg';
import forestCanopy from '../assets/img/new_imgs/AVqgzruh.jpg';
import cycling from '../assets/img/new_imgs/XH3dQZHb.jpg';
import morningRoad from '../assets/img/new_imgs/vqGFiQqs.jpg';
import bisonHerd from '../assets/img/new_imgs/56GxlSpD.jpg';
import winterBison from '../assets/img/new_imgs/i0O3c6C2.jpg';
import deer from '../assets/img/new_imgs/LxWAZ97s.jpg';
import sunset from '../assets/img/new_imgs/YfUEWgGU.jpg';
import winterRoad from '../assets/img/new_imgs/Hwn3MNkR.jpg';
import frostyTree from '../assets/img/new_imgs/vcK8xM3x.jpg';

const sections = [
  {
    id: 'zewnetrze',
    label: 'Zewnętrze',
    eyebrow: 'Dom i otoczenie',
    description: 'Przestronny dom otoczony zielenią, z ogrodem i miejscem na wspólny wypoczynek na świeżym powietrzu.',
    photos: [
      { src: houseFront, alt: 'Wejście na posesję Papierówki z niebieskimi i zielonymi okiennicami', title: 'Witajcie w Papierówce', layout: 'feature', focus: 'front' },
      { src: houseSpring, alt: 'Dom z balkonem i niebieskimi okiennicami za kwitnącym drzewem', title: 'Wiosna przy domu', layout: 'portrait', focus: 'house' },
      { src: outside, alt: 'Dom agroturystyczny otoczony zielenią', title: 'Dom', layout: 'square', focus: 'house' },
      { src: gazebo, alt: 'Drewniana altana z miejscem do wypoczynku', title: 'Altana', layout: 'square', focus: 'gazebo' },
      { src: gazebo1, alt: 'Altana ogrodowa widziana z boku', title: 'Altana ogrodowa', layout: 'square', focus: 'gazebo' },
    ],
  },
  {
    id: 'wnetrza',
    label: 'Wnętrza',
    eyebrow: 'Środek domu',
    description: 'Przytulne, przestronne wnętrza z kominkiem, dużym salonem i wszystkim, czego potrzeba do wspólnego wypoczynku.',
    photos: [
      { src: lounge, alt: 'Salon z narożną sofą, fotelami i schodami na piętro', title: 'Salon', layout: 'feature', focus: 'lounge' },
      { src: fireplace, alt: 'Rozpalony kominek i gry planszowe przygotowane dla gości', title: 'Kominek i gry', layout: 'portrait', focus: 'fireplace' },
      { src: living, alt: 'Przytulny salon z drewnianymi elementami', title: 'Wnętrze', layout: 'square', focus: 'lounge' },
      { src: entry, alt: 'Drewniane wnętrze domu', title: 'Domowe ciepło', layout: 'square', focus: 'lounge' },
      { src: cosyDetails, alt: 'Kwiaty i słodycze na stole, w tle rozpalony piecyk', title: 'Przytulne detale', layout: 'square', focus: 'details' },
    ],
  },
  {
    id: 'ogrod',
    label: 'Ogród i relaks',
    eyebrow: 'Na zewnątrz',
    description: 'Ogród, plac zabaw i basen w sezonie — miejsca na wspólny odpoczynek i zabawę.',
    photos: [
      { src: pool, alt: 'Okrągły basen ogrodowy, a za nim kolorowy domek ze zjeżdżalnią', title: 'Basen w sezonie', layout: 'full-frame' },
      { src: playground, alt: 'Kolorowy drewniany domek dla dzieci ze schodkami i niebieską zjeżdżalnią', title: 'Dla najmłodszych', layout: 'full-frame' },
      { src: apples, alt: 'Zielone jabłka na gałęzi, w tle ogród z basenem i placem zabaw', title: 'Lato w ogrodzie', layout: 'full-frame' },
    ],
  },
  {
    id: 'okolica',
    label: 'Okolica',
    eyebrow: 'Blisko natury',
    description: 'Leśne ścieżki, rowerowe wyprawy, dzikie zwierzęta i krajobrazy zmieniające się wraz z porami roku.',
    photos: [
      { src: autumnTrail, alt: 'Leśna droga pośród drzew o złotych i pomarańczowych liściach', title: 'Jesienne spacery', layout: 'feature', focus: 'autumn' },
      { src: cycling, alt: 'Rowery przy leśnej drodze otoczonej zielonymi drzewami', title: 'Na dwóch kółkach', layout: 'portrait', focus: 'cycling' },
      { src: forestStream, alt: 'Leśny strumień otoczony bujną zielenią w słoneczny dzień', title: 'Nad strumieniem', layout: 'square', focus: 'stream' },
      { src: forestCanopy, alt: 'Wysoki pień porośnięty mchem i korony drzew widziane od dołu', title: 'Spójrzcie w górę', layout: 'square', focus: 'canopy' },
      { src: morningRoad, alt: 'Promienie słońca przebijające przez mgłę nad leśną drogą', title: 'Światło o poranku', layout: 'feature', focus: 'light' },
      { src: winterBison, alt: 'Żubr z pyskiem i sierścią pokrytymi śniegiem', title: 'Zimowe spotkanie', layout: 'portrait', focus: 'bison' },
      { src: bisonHerd, alt: 'Stado żubrów stojących blisko siebie na łące', title: 'Żubry', layout: 'square', focus: 'herd' },
      { src: frostyTree, alt: 'Drzewo pokryte szronem na zaśnieżonym polu pod błękitnym niebem', title: 'Krajobraz w bieli', layout: 'portrait', focus: 'frost' },
      { src: deer, alt: 'Jeleń z porożem wśród zielonych roślin na skraju lasu', title: 'Leśni mieszkańcy', layout: 'wide', focus: 'deer' },
      { src: sunset, alt: 'Zachodzące słońce widoczne między gałęziami drzewa iglastego', title: 'Spokojny wieczór', layout: 'square', focus: 'sunset' },
      { src: greenTrail, alt: 'Wąska ścieżka w lesie pełnym zielonych liści i paproci', title: 'Zielone ścieżki', layout: 'wide', focus: 'green' },
      { src: winterRoad, alt: 'Ośnieżona droga przez las w niebieskim świetle zmierzchu', title: 'Zima w lesie', layout: 'wide', focus: 'winter' },
    ],
  },
];

// Full-size previews also use WebP; retain the supplied JPEGs as source files.
const gallerySections = await Promise.all(sections.map(async (section) => ({
  ...section,
  photos: await Promise.all(section.photos.map(async (photo) => ({
    ...photo,
    preview: await getImage({
      src: photo.src,
      width: Math.round(photo.src.width * Math.min(1, 1600 / Math.max(photo.src.width, photo.src.height))),
      format: 'webp',
      quality: 80,
    }),
    widths: [...new Set([480, 720, 960, 1280, photo.src.width].filter((width) => width <= Math.min(photo.src.width, 1280)))],
  }))),
})));
---

<div class="gallery-root" aria-label="Galeria zdjęć Papierówki">
  <nav class="gallery-nav" aria-label="Sekcje galerii">
    {sections.map(s => (
      <a class="gallery-nav-link" href={`#${s.id}`}>{s.label}</a>
    ))}
  </nav>

  {gallerySections.map((section) => (
    <section class="gallery-section" id={section.id} aria-labelledby={`${section.id}-heading`}>
      <NatureGallery section={section} />
    </section>
  ))}
</div>

<script is:inline src={galleryScriptUrl} defer></script>

<style>
  /* Nav */
  .gallery-nav{display:flex;flex-wrap:wrap;gap:var(--space-2);margin-bottom:var(--space-10)}
  .gallery-nav-link{display:inline-flex;min-height:40px;align-items:center;padding:var(--space-2) var(--space-5);border:1px solid var(--color-line);border-radius:var(--radius-pill);background:var(--color-white);color:var(--color-ink);font-size:.88rem;font-weight:600;text-decoration:none;transition:background .2s,border-color .2s,transform .2s}
  .gallery-nav-link:hover{background:var(--color-soft);border-color:var(--color-forest);transform:translateY(-1px)}

  /* Section */
  .gallery-section{margin-bottom:var(--space-16)}
  .gallery-section:last-child{margin-bottom:0}
</style>
