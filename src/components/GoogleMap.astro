---
import { site } from '../config/site';
interface Props { title?: string }
const { title = `Mapa dojazdu do Papierówki — ${site.address}, ${site.postalCode} ${site.addressLocality}` } = Astro.props;
---
<div class="map-frame">
  <iframe
    src={site.googleMapsEmbedUrl}
    title={title}
    loading="lazy"
    referrerpolicy="strict-origin-when-cross-origin"
    allowfullscreen
  ></iframe>
</div>
<style>
  .map-frame{overflow:hidden;min-height:360px;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-soft);box-shadow:var(--shadow-card)}
  iframe{display:block;width:100%;height:100%;min-height:360px;border:0}
  @media(max-width:650px){.map-frame,iframe{min-height:300px}}
</style>
