---
import { site } from '../config/site';
import reviewsScriptUrl from '../scripts/reviews-slider.js?url&no-inline';
---
<reviews-slider role="region" aria-roledescription="karuzela" aria-label="Opinie gości">
  <p class="review-help" id="guest-reviews-help">Przesuń opinie palcem, kółkiem myszy lub trackpadem. Po wybraniu listy możesz też użyć strzałek na klawiaturze.</p>
  <div class="track" tabindex="0" role="group" aria-label="Lista opinii gości" aria-describedby="guest-reviews-help" id="guest-reviews-track">
    {site.reviews.map((review, index) => <figure class="review-card" aria-label={`Opinia ${index + 1} z ${site.reviews.length}`}>
      <span class="quote" aria-hidden="true">“</span>
      <div class="review-rating" role="img" aria-label={`Ocena: ${review.rating} na 5 gwiazdek`}>
        <span class="review-stars" aria-hidden="true">
          {Array.from({ length: 5 }, (_, star) => <svg width="18" height="18" viewBox="0 0 24 24" fill={star < review.rating ? 'currentColor' : 'none'} stroke="currentColor" stroke-width="1.5" stroke-linejoin="round"><path d="m12 3 2.78 5.63 6.22.91-4.5 4.39 1.06 6.2L12 17.2l-5.56 2.93 1.06-6.2L3 9.54l6.22-.91L12 3Z" /></svg>)}
        </span>
        <span aria-hidden="true">{review.rating}/5</span>
      </div>
      <blockquote><p class="review-text" data-review-text>{review.text}</p></blockquote>
      <div class="review-more-slot"><button class="review-more" type="button" data-review-more aria-label={`Czytaj całą opinię: ${review.author}`} aria-haspopup="dialog" aria-controls="guest-review-dialog" hidden>Czytaj więcej</button></div>
      <figcaption>
        <cite data-review-author>{review.author}</cite>
        <span data-review-date>{review.date}</span>
        {review.url && (
          <a class="review-source" href={review.url} target="_blank" rel="noopener noreferrer" aria-label={`Zobacz opinię w Google: ${review.author}`}>
            Zobacz opinię w Google <span aria-hidden="true">↗</span>
          </a>
        )}
      </figcaption>
    </figure>)}
  </div>
  <div class="controls" hidden>
    <button class="review-arrow" type="button" data-prev aria-label="Poprzednia opinia" aria-controls="guest-reviews-track"><span aria-hidden="true">←</span></button>
    <div class="review-dots" role="group" aria-label="Pozycja na liście opinii">
      {site.reviews.map((_, index) => <button class="review-dot" type="button" data-review-dot aria-label={`Przejdź do opinii ${index + 1} z ${site.reviews.length}`} aria-controls="guest-reviews-track" aria-current={index === 0 ? 'true' : undefined}><span aria-hidden="true"></span></button>)}
    </div>
    <button class="review-arrow" type="button" data-next aria-label="Następna opinia" aria-controls="guest-reviews-track"><span aria-hidden="true">→</span></button>
  </div>
  <p class="review-status" data-review-status aria-live="polite" aria-atomic="true"></p>
  <dialog class="review-dialog" id="guest-review-dialog" aria-labelledby="guest-review-title">
    <div class="review-dialog-header"><h3 id="guest-review-title">Opinia gościa</h3><button class="review-close" type="button" data-review-close aria-label="Zamknij pełną opinię"><span aria-hidden="true">×</span></button></div>
    <p class="review-dialog-rating" data-review-full-rating></p>
    <figure><blockquote><p data-review-full-text></p></blockquote><figcaption><cite data-review-full-author></cite><span data-review-full-date></span></figcaption></figure>
    <div data-review-full-source></div>
  </dialog>
</reviews-slider>
<script is:inline src={reviewsScriptUrl} defer></script>
<style>
  reviews-slider{--review-columns:1.1;--review-gaps:1;--review-gap:var(--space-4);--review-lines:5;--review-line-height:1.7;--review-dialog-width:40rem;--review-quote-size:2.5rem;--review-control-size:3rem;--color-rating-gold:#a66e00;display:block;margin-inline:auto}
  .review-help{margin:0 auto var(--space-3);color:var(--color-muted);font-size:.84rem;text-align:center}
  .track{position:relative;display:grid;grid-auto-flow:column;grid-auto-columns:calc((100% - var(--review-gap) * var(--review-gaps)) / var(--review-columns));gap:var(--review-gap);align-items:stretch;overflow-x:auto;scroll-snap-type:x mandatory;scroll-padding-inline:var(--space-2);padding:var(--space-3) var(--space-2) var(--space-5);scrollbar-width:thin;scrollbar-color:var(--color-forest) var(--color-soft)}
  .track:focus-visible{outline:var(--focus-ring-width) solid var(--color-focus);outline-offset:calc(-1 * var(--space-1))}
  .review-card{display:flex;min-width:0;flex-direction:column;align-items:flex-start;margin:0;padding:var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card);scroll-snap-align:start}
  .quote{color:var(--color-forest);font:600 var(--review-quote-size)/1 'Lora',Georgia,serif}
  .review-rating{display:flex;align-items:center;gap:var(--space-2);margin:var(--space-2) 0 var(--space-4);color:var(--color-muted);font-size:.84rem;font-weight:700;line-height:1}
  .review-stars{display:flex;gap:var(--space-1);color:var(--color-rating-gold)}
  blockquote{flex:1;width:100%;min-width:0;margin:0}
  .review-text{margin:0;color:var(--color-ink);font-size:1rem;line-height:var(--review-line-height);overflow-wrap:anywhere}
  /* Without JavaScript, the native scroller retains every complete review. */
  .track[data-clamped] .review-text{display:-webkit-box;min-block-size:calc(var(--review-lines) * var(--review-line-height) * 1em);max-block-size:calc(var(--review-lines) * var(--review-line-height) * 1em);overflow:hidden;-webkit-box-orient:vertical;-webkit-line-clamp:var(--review-lines);line-clamp:var(--review-lines)}
  .review-more-slot{min-height:var(--tap-target);margin-block:var(--space-2) var(--space-4)}
  .review-more{display:inline-flex;min-height:var(--tap-target);align-items:center;padding-inline:var(--space-4);border:0;border-radius:var(--radius-pill);background-color:var(--color-forest);color:var(--color-white);font:inherit;font-weight:700;cursor:pointer;transition:background-color var(--motion-duration) var(--motion-ease)}
  .review-more[hidden]{display:none}
  .review-source{display:inline-flex;min-block-size:var(--tap-target);align-items:center;gap:var(--space-1);color:var(--color-cta);font-weight:600;text-decoration:underline;text-underline-offset:var(--space-1)}
  figcaption{display:flex;flex-direction:column;gap:var(--space-1);margin-top:auto}
  cite{color:var(--color-ink);font-style:normal;font-weight:700}
  figcaption>span{color:var(--color-muted);font-size:.84rem;font-weight:500}
  .controls{display:flex;align-items:center;justify-content:center;gap:var(--space-3);margin-top:var(--space-3)}.controls[hidden]{display:none}
  .review-arrow,.review-close{display:grid;flex-shrink:0;width:var(--review-control-size);height:var(--review-control-size);place-items:center;padding:0;border:1px solid var(--color-line);border-radius:var(--radius-pill);background:var(--color-white);color:var(--color-forest);font:inherit;font-size:1.5rem;cursor:pointer;transition:background-color var(--motion-duration) var(--motion-ease)}
  .review-arrow:disabled{opacity:.4;cursor:default}
  .review-dots{display:flex;align-items:center;justify-content:center}
  .review-dot{display:grid;width:var(--tap-target);height:var(--tap-target);place-items:center;padding:0;border:0;border-radius:var(--radius-pill);background:transparent;cursor:pointer}
  .review-dot[hidden]{display:none}
  .review-dot span{width:var(--space-2);height:var(--space-2);border:1px solid var(--color-forest);border-radius:var(--radius-pill);background:transparent;transition:background-color var(--motion-duration) var(--motion-ease)}
  .review-dot[aria-current="true"] span{background:var(--color-forest)}
  .review-status{position:absolute;width:1px;height:1px;overflow:hidden;clip-path:inset(50%);white-space:nowrap}
  .review-dialog{width:min(var(--review-dialog-width),calc(100% - var(--space-8)));max-height:calc(100vh - var(--space-8));max-height:calc(100dvh - var(--space-8));padding:clamp(var(--space-5),4vw,var(--space-8));overflow-y:auto;overscroll-behavior:contain;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);color:var(--color-ink)}
  .review-dialog::backdrop{background:var(--color-dialog-backdrop)}
  .review-dialog-header{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);margin-bottom:var(--space-4)}
  .review-dialog h3{margin:0;font-family:'Lora',Georgia,serif;font-size:1.35rem}
  .review-dialog-rating{color:var(--color-forest);font-weight:700}
  .review-dialog figure{margin:0}.review-dialog blockquote p{margin:0 0 var(--space-6);line-height:var(--review-line-height);overflow-wrap:anywhere}
  @media(hover:hover){
    .review-arrow:hover:enabled,.review-close:hover{background:var(--color-soft)}
    .review-more:hover{background-color:var(--color-forest-dark)}
    .review-source:hover{color:var(--color-cta-hover)}
    .review-dot:hover span{background:var(--color-soft)}
    .review-dot[aria-current="true"]:hover span{background:var(--color-forest)}
  }
  @media(min-width:651px){reviews-slider{--review-columns:2}}
  @media(min-width:1024px){reviews-slider{--review-columns:3;--review-gaps:2}}
  @media(max-width:650px){.review-arrow{display:none}}
</style>
