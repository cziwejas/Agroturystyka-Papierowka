---
import { site } from '../config/site';
---
<section class="section area"><div class="container area-inner"><div><span class="eyebrow">Warto ruszyć w drogę</span><h2>Odkryj okolicę</h2><p>Miejscowość Wasilkowo to dobra baza do spokojnych spacerów, wycieczek rowerowych i poznawania Podlasia. Sprawdź pobliskie miejsca i zaplanuj swój dzień.</p><a href={site.mapUrl} target="_blank" rel="noopener noreferrer">Zobacz mapę okolicy ↗</a></div><ul>{site.areaDistances.map((item) => <li><span>{item.place}</span><strong>{item.distance}</strong></li>)}</ul></div></section>
<style>.area{background:var(--color-white)}.area-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.8fr);gap:clamp(var(--space-8),8vw,var(--space-16));align-items:center}.area p{max-width:52ch;color:var(--color-muted)}.area a{display:inline-flex;min-height:44px;align-items:center;color:var(--color-cta);font-weight:700;text-underline-offset:4px}.area a:hover{color:var(--color-cta-hover);text-decoration-thickness:2px}.area ul{margin:0;padding:var(--space-4) var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-paper);list-style:none}.area li{display:flex;justify-content:space-between;gap:var(--space-4);padding:var(--space-4) 0;border-bottom:1px solid var(--color-line)}.area li:last-child{border-bottom:0}.area li strong{color:var(--color-forest)}@media(max-width:700px){.area-inner{grid-template-columns:1fr}}</style>
