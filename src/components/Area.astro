---
import { site } from '../config/site';
import { Image } from 'astro:assets';
import forest from '../assets/img/new_imgs/chf_cCke.jpg';
import cycling from '../assets/img/new_imgs/XH3dQZHb.jpg';
import winter from '../assets/img/new_imgs/vcK8xM3x.jpg';
const photos = [
  { src: forest, alt: 'Zielona ścieżka pośród drzew i paproci', caption: 'Spacery po lesie' },
  { src: cycling, alt: 'Rowery przygotowane do wycieczki przy leśnej drodze', caption: 'Rowerowe wyprawy' },
  { src: winter, alt: 'Oszronione drzewo na śniegu pod błękitnym niebem', caption: 'O każdej porze roku' },
];
---
<section class="section area">
  <div class="container">
    <div class="area-inner"><div><span class="eyebrow">Warto ruszyć w drogę</span><h2>Odkryj okolicę</h2><p>Miejscowość Wasilkowo to dobra baza do spokojnych spacerów, wycieczek rowerowych i poznawania Podlasia. Sprawdź pobliskie miejsca i zaplanuj swój dzień.</p><a href={site.mapUrl} target="_blank" rel="noopener noreferrer">Zobacz mapę okolicy ↗</a></div><ul>{site.areaDistances.map((item) => <li><span>{item.place}</span><strong>{item.distance}</strong></li>)}</ul></div>
    <div class="area-photos">
      {photos.map((photo) => <figure><Image src={photo.src} alt={photo.alt} width={720} widths={[360, 560, 720]} sizes="(max-width: 700px) calc(100vw - 40px), (max-width: 1160px) 33vw, 363px" format="webp" quality={78} loading="lazy" /><figcaption>{photo.caption}</figcaption></figure>)}
    </div>
    <a class="area-gallery-link" href="/galeria/#okolica">Zobaczcie zdjęcia okolicy →</a>
  </div>
</section>
<style>
  .area-photos{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-5);margin-top:var(--space-10)}
  .area-photos figure{margin:0;overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-paper)}
  .area-photos img{display:block;width:100%;aspect-ratio:4/3;object-fit:cover}
  .area-photos figcaption{padding:var(--space-4) var(--space-5);font-weight:600}
  .area-gallery-link{margin-top:var(--space-5)}
  @media(max-width:700px){.area-photos{grid-template-columns:1fr}}
</style>
<style>.area{background:var(--color-white)}.area-inner{display:grid;grid-template-columns:minmax(0,1fr) minmax(280px,.8fr);gap:clamp(var(--space-8),8vw,var(--space-16));align-items:center}.area p{max-width:52ch;color:var(--color-muted)}.area a{display:inline-flex;min-height:44px;align-items:center;color:var(--color-cta);font-weight:700;text-underline-offset:4px}.area a:hover{color:var(--color-cta-hover);text-decoration-thickness:2px}.area ul{margin:0;padding:var(--space-4) var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-paper);list-style:none}.area li{display:flex;justify-content:space-between;gap:var(--space-4);padding:var(--space-4) 0;border-bottom:1px solid var(--color-line)}.area li:last-child{border-bottom:0}.area li strong{color:var(--color-forest)}@media(max-width:700px){.area-inner{grid-template-columns:1fr}}</style>
