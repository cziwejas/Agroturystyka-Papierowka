---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import Amenities from '../components/Amenities.astro';
import GoogleMap from '../components/GoogleMap.astro';
import SocialLinks from '../components/SocialLinks.astro';
import { site } from '../config/site';
const title = 'Papierówka — agroturystyka na Podlasiu';
---
<BaseLayout title={title}><Hero />
  <section class="welcome section"><div class="container"><span class="eyebrow">Dobrze, że jesteś</span><h2>Znajdź swój spokojny zakątek</h2><p>Zapraszamy do Papierówki — miejsca z domową atmosferą, gdzie można zwolnić, spędzić czas razem i cieszyć się podlaską przyrodą. To wygodna przestrzeń na wspólny wypoczynek rodzin i grup.</p><a href="/o-nas/">Poznaj nasze miejsce →</a></div></section>
  <section class="facts" aria-label="Najważniejsze informacje o pobycie"><dl class="container facts-grid"><div><dt>Pobyt komfortowy</dt><dd><strong>8 osób</strong><span>do 10 z 2 miejscami w salonie</span></dd></div><div><dt>Przy tygodniowym pobycie</dt><dd><strong>od 500 zł</strong><span>za dobę · weekendy do uzgodnienia</span></dd></div><div><dt>Od Puszczy Białowieskiej</dt><dd><strong>1 km</strong><span>sklep 6 km · Białowieża 30 km</span></dd></div></dl></section>
  <section class="bison-highlight" aria-labelledby="bison-title"><div class="container"><span class="eyebrow">Podlaska przyroda</span><h2 id="bison-title">Blisko Puszczy i żubrów</h2><p>Puszcza Białowieska zaczyna się kilometr od Papierówki. W okolicy można wypatrywać żubrów, a Rezerwat Pokazowy Żubrów znajduje się około 30 km od nas.</p></div></section>
  <Amenities />
  <section class="section location" aria-labelledby="location-title"><div class="container"><article class="location-card"><div class="location-heading"><span class="eyebrow">Jak do nas trafić</span><h2 id="location-title">Papierówka na mapie</h2><p>Wasilkowo · 1 km od Puszczy Białowieskiej</p></div><div class="location-map"><GoogleMap title={`Mapa lokalizacji Papierówki przy adresie ${site.address}, ${site.postalCode} ${site.addressLocality}`} /></div><div class="location-footer"><div><strong>{site.address}</strong><span>{site.postalCode} {site.addressLocality}, województwo podlaskie</span></div><a class="button" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">Wyznacz trasę <span aria-hidden="true">↗</span></a></div></article></div></section>
  {site.showReviews && <section class="section reviews"><div class="container"><div class="section-title"><span class="eyebrow">Głosy gości</span><h2>Miłe wspomnienia</h2></div><div class="review-grid">{site.reviews.map((review) => <blockquote><span aria-hidden="true">“</span><p>{review.text}</p><cite>{review.author} · {review.date}</cite></blockquote>)}</div><div class="reviews-link"><a class="google-reviews-button" href={site.googleReviewsUrl} target="_blank" rel="noopener noreferrer"><svg aria-hidden="true" viewBox="0 0 48 48" width="21" height="21"><path fill="#4285F4" d="M43.6 24.5c0-1.4-.1-2.8-.4-4.1H24v7.8h11a9.4 9.4 0 0 1-4.1 6.2v5.1h6.7c3.9-3.6 6-8.8 6-15Z"/><path fill="#34A853" d="M24 44c5.5 0 10.1-1.8 13.5-4.8l-6.7-5.1c-1.8 1.2-4.1 2-6.8 2-5.2 0-9.6-3.5-11.2-8.2H5.9v5.3A20 20 0 0 0 24 44Z"/><path fill="#FBBC05" d="M12.8 27.9a12 12 0 0 1 0-7.8v-5.3H5.9a20 20 0 0 0 0 18.4l6.9-5.3Z"/><path fill="#EA4335" d="M24 11.9c3 0 5.7 1 7.8 3.1l5.8-5.8C34.1 5.8 29.5 4 24 4A20 20 0 0 0 5.9 14.8l6.9 5.3c1.6-4.7 6-8.2 11.2-8.2Z"/></svg><span>Zobacz opinie w Google</span></a></div><div class="social-follow"><strong>Obserwuj Papierówkę</strong><SocialLinks /></div></div></section>}
  <section class="cta"><div class="container cta-inner"><div><span class="eyebrow">Zaplanuj pobyt</span><h2>Masz pytania? Porozmawiajmy.</h2><p>Rezerwacje przyjmujemy telefonicznie i e-mailem.</p></div><a class="button button--light" href="/kontakt/">Zadzwoń lub napisz</a></div></section>
</BaseLayout>
<style>
  .welcome{text-align:center;background:var(--color-white)}.welcome .container{max-width:760px}.welcome h2{margin:var(--space-3) 0}.welcome p,.why p{color:var(--color-muted)}.welcome p{margin-inline:auto}.welcome a{display:inline-flex;min-height:44px;align-items:center;color:var(--color-cta);font-weight:700;text-underline-offset:4px}.welcome a:hover{color:var(--color-cta-hover);text-decoration-thickness:2px}
  .facts{padding:var(--space-6) 0;background:var(--color-white)}.facts-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:1px;overflow:hidden;margin-top:calc(-1 * var(--space-10));padding:0;border-radius:var(--radius-card);background:#ffffff20;box-shadow:var(--shadow-card)}.facts-grid>div{display:flex;min-height:142px;flex-direction:column;justify-content:center;padding:var(--space-6);background:var(--color-forest-dark);color:var(--color-white)}.facts dt,.facts-grid span{color:var(--color-muted-on-forest)}.facts dt{font-size:.84rem;font-weight:600}.facts dd{margin:var(--space-1) 0 0}.facts dd strong{display:block;color:var(--color-white);font-size:clamp(1.55rem,3vw,2.15rem);font-weight:700;letter-spacing:-.04em}.facts-grid span{display:block;font-size:.85rem;line-height:1.45}
  .bison-highlight{padding:var(--space-8) 0;background:var(--color-soft);text-align:center}.bison-highlight .container{max-width:780px}.bison-highlight h2{margin:var(--space-2) 0;font-size:clamp(1.6rem,3vw,2.2rem)}.bison-highlight p{margin:0 auto;color:var(--color-muted)}
  .location{background:var(--color-white)}.location-card{overflow:hidden;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}.location-heading{padding:clamp(var(--space-6),4vw,var(--space-8)) clamp(var(--space-6),5vw,var(--space-10)) var(--space-4)}.location-heading h2{margin:var(--space-2) 0}.location-heading p{margin:0;color:var(--color-muted)}:global(.location-map .map-frame){height:clamp(320px,42vw,480px);min-height:320px;border:0;border-radius:0;box-shadow:none}:global(.location-map iframe){height:100%;min-height:320px}.location-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-5) clamp(var(--space-6),5vw,var(--space-10));background:var(--color-soft)}.location-footer>div{display:flex;flex-direction:column;line-height:1.5}.location-footer>div span{color:var(--color-muted);font-size:.9rem}.location-footer .button{flex-shrink:0;background:var(--color-forest-dark);box-shadow:none}.location-footer .button:hover{background:var(--color-forest)}
  .reviews{background:var(--color-paper)}.review-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4);align-items:stretch}blockquote{display:flex;min-width:0;flex-direction:column;margin:0;padding:var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}blockquote>span{margin-bottom:var(--space-2);color:var(--color-forest);font:600 2.5rem 'Lora',Georgia,serif;line-height:.8}blockquote p{flex:1;margin:0 0 var(--space-5);color:var(--color-ink);font-size:.96rem;line-height:1.7}cite{color:var(--color-muted);font-size:.84rem;font-style:normal;font-weight:700}
  .reviews-link{display:flex;justify-content:center;margin-top:var(--space-6)}.google-reviews-button{display:inline-flex;min-height:48px;align-items:center;justify-content:center;gap:var(--space-3);padding:var(--space-3) var(--space-6);border:1px solid #dadce0;border-radius:var(--radius-pill);background:#fff;color:#3c4043;font-weight:600;text-decoration:none;box-shadow:0 1px 2px #0000001a;transition:background .2s ease,box-shadow .2s ease}.google-reviews-button:hover{background:#f8faff;box-shadow:0 2px 6px #00000026}
  .social-follow{display:flex;align-items:center;justify-content:center;gap:var(--space-4);margin-top:var(--space-8);color:var(--color-ink)}:global(.social-follow .social-links a){border-color:var(--color-line);background:var(--color-white);color:var(--color-ink)}:global(.social-follow .social-links a:hover){background:var(--color-soft)}
  .cta{padding:var(--space-12) 0;background:var(--color-forest);color:var(--color-white)}.cta .eyebrow{color:var(--color-muted-on-forest)}.cta h2{margin:var(--space-1) 0;font-size:clamp(1.8rem,4vw,2.5rem)}.cta p{margin:0;color:var(--color-muted-on-forest)}.cta-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-8)}
  @media(max-width:900px){.review-grid{grid-template-columns:1fr 1fr}.review-grid blockquote:last-child{grid-column:1/-1}}
  @media(max-width:650px){.facts-grid{grid-template-columns:1fr;margin-top:calc(-1 * var(--space-8))}.facts-grid>div{min-height:unset;padding:var(--space-5) var(--space-6)}.review-grid{grid-template-columns:1fr}.review-grid blockquote:last-child{grid-column:auto}.social-follow{align-items:center;flex-direction:column}.location-footer{align-items:flex-start;flex-direction:column}.location-footer .button{width:100%}.cta-inner{align-items:flex-start;flex-direction:column}}
</style>
