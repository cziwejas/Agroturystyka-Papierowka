---
import BaseLayout from '../layouts/BaseLayout.astro';
import Gallery from '../components/Gallery.astro';
---
<BaseLayout title="Galeria — Papierówka" description="Zobacz dom i otoczenie agroturystyki Papierówka w miejscowości Wasilkowo.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Zajrzyj do środka</span><h1>Galeria</h1><p>Zobacz dom, jego wnętrza i miejsca do odpoczynku.</p></div></section>
  <section class="section"><div class="container"><Gallery /></div></section>
</BaseLayout>
<style>.page-hero{padding-block:clamp(var(--space-12),8vw,var(--space-16));background:var(--color-soft)}.page-hero h1{margin:var(--space-2) 0}.page-hero p{margin-bottom:0;color:var(--color-muted)}</style>
