---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Area from '../components/Area.astro';
import living from '../assets/img/salon.jpg';
import veranda from '../assets/img/Papierówka_047.jpg';
---
<BaseLayout title="O nas — Papierówka" description="Poznaj Papierówkę: przestronny dom i zielony teren na spokojny wypoczynek w miejscowości Wasilkowo na Podlasiu.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Nasze miejsce</span><h1>O Papierówce</h1><p>Dom, w którym łatwo złapać oddech i pobyć razem.</p></div></section>
  <section class="section story"><div class="container story-grid"><figure class="photo photo--living"><Image src={living} alt="Jasny salon Papierówki z dużą sofą i drewnianymi schodami" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy"/><figcaption>Przestrzeń do wspólnego odpoczynku</figcaption></figure><div class="story-copy"><span class="eyebrow">Dom otwarty na wspólny czas</span><h2>Przyjedźcie, rozgośćcie się, odpocznijcie</h2><p>Papierówka to duży, wygodny dom dla rodzin i grup. Wspólny posiłek, spokojny wieczór przy kominku czy leniwy poranek — każdy może tu złapać własny rytm, a przestronny salon sprzyja spędzaniu czasu razem.</p><p>Dom mieści komfortowo 8 osób, a na sofie w salonie są dwa dodatkowe miejsca do spania. Wasilkowo leży kilometr od Puszczy Białowieskiej i około 30 km od Białowieży — to spokojna baza do odkrywania okolicy przez cały rok. Goście mają do dyspozycji w pełni wyposażoną kuchnię, Wi-Fi i klimatyzację na obu piętrach.</p><div class="capacity"><div><strong>8</strong><span>osób komfortowo</span></div><i aria-hidden="true"></i><div><strong>10</strong><span>miejsc noclegowych</span></div></div></div></div></section>
  <section class="section outdoor"><div class="container outdoor-grid"><div class="outdoor-copy"><span class="eyebrow">Wypoczynek po swojemu</span><h2>Blisko natury, z miejscem na relaks</h2><p>W domu i ogrodzie znajdziecie wszystko, czego potrzeba do wspólnego wypoczynku — niezależnie od pory roku. Strefa relaksu z sauną i banią pod zadaszoną wiatą jest dostępna przez cały rok (dodatkowo płatna). W ogrodzie czeka duży, zarybiony staw — można nad nim odpocząć, a w ciepłe dni także popływać. Wieczorami warto rozpalić ognisko nad stawem i posłuchać podlaskiej ciszy.</p><ul class="highlights"><li>W pełni wyposażona kuchnia, Wi-Fi i klimatyzacja na obu piętrach</li><li>Sauna i bania pod zadaszoną wiatą — czynne przez cały rok</li><li>Wiata ogrodowa, grill gazowy i ognisko nad stawem</li><li>Duży, zarybiony staw, w którym można się kąpać</li><li>Rowery i spokojne trasy w okolicy</li><li>Placyk zabaw, trampolina i basen w sezonie</li><li>Ogród i ogrodzony teren — zwierzęta mile widziane</li><li>Parking na terenie posesji dla kilku aut</li><li>1 km od Puszczy Białowieskiej — szanse na spotkanie żubrów</li></ul></div><figure class="photo photo--veranda"><Image src={veranda} alt="Zadaszona weranda Papierówki z drewnianym stołem i miejscami do siedzenia" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy"/><figcaption>Weranda na wspólne chwile o każdej porze dnia</figcaption></figure></div></section>
  <Area />
  <section class="cta-strip section"><div class="container cta-strip-inner"><div><span class="eyebrow">Zaplanuj pobyt</span><h2>Gotowi na wyjazd?</h2><p>Sprawdź ofertę i ceny lub napisz do nas — ustalimy termin i szczegóły.</p></div><div class="cta-strip-buttons"><a class="button" href="/oferta/">Zobacz ofertę i ceny</a><a class="button button--outline" href="/kontakt/">Skontaktuj się</a></div></div></section>
</BaseLayout>
<style>
  .story{background:var(--color-white)}.story-grid,.outdoor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(var(--space-8),7vw,var(--space-16));align-items:center}.photo{position:relative;overflow:hidden;margin:0;border-radius:var(--radius-card);background:var(--color-soft);box-shadow:var(--shadow-card)}.photo img{display:block;width:100%;height:100%;min-height:380px;object-fit:cover}.photo--living img{aspect-ratio:4/3}.photo--veranda img{aspect-ratio:4/3}.photo figcaption{position:absolute;right:0;bottom:0;left:0;padding:var(--space-8) var(--space-6) var(--space-5);background:linear-gradient(transparent,var(--color-gallery-overlay));color:var(--color-white);font-size:.9rem;font-weight:600}
  .story-copy h2,.outdoor-copy h2{margin:var(--space-2) 0 var(--space-4)}.story-copy p,.outdoor-copy p{color:var(--color-muted)}.capacity{display:flex;align-items:center;gap:var(--space-6);margin-top:var(--space-8);padding:var(--space-5) var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-paper)}.capacity>div{display:flex;align-items:center;gap:var(--space-3)}.capacity strong{color:var(--color-forest-dark);font-family:'Lora',Georgia,serif;font-size:2rem;line-height:1}.capacity span{max-width:9ch;color:var(--color-muted);font-size:.85rem;line-height:1.3}.capacity i{width:1px;height:42px;background:var(--color-line)}
  .outdoor{background:var(--color-soft)}.outdoor-grid{grid-template-areas:'copy photo'}.outdoor-copy{grid-area:copy}.photo--veranda{grid-area:photo}.highlights{display:grid;gap:var(--space-3);margin:var(--space-6) 0 0;padding:0;list-style:none}.highlights li{display:flex;align-items:flex-start;gap:var(--space-3);color:var(--color-ink)}.highlights li::before{content:'';flex:0 0 8px;width:8px;height:8px;margin-top:.55em;border-radius:50%;background:var(--color-forest)}
  .cta-strip{background:var(--color-forest);color:var(--color-white)}.cta-strip .eyebrow{color:var(--color-muted-on-forest)}.cta-strip h2{margin:var(--space-1) 0;font-size:clamp(1.8rem,4vw,2.5rem)}.cta-strip p{margin:0;color:var(--color-muted-on-forest)}.cta-strip-inner{display:flex;align-items:center;justify-content:space-between;gap:var(--space-8)}.cta-strip-buttons{display:flex;flex-shrink:0;gap:var(--space-4)}.button--outline{background:transparent;border:2px solid var(--color-white);color:var(--color-white);box-shadow:none}.button--outline:hover{background:#ffffff20;transform:translateY(-2px)}
  @media(max-width:850px){.story-grid,.outdoor-grid{gap:var(--space-8)}}
  @media(max-width:650px){.story-grid,.outdoor-grid{grid-template-columns:1fr}.outdoor-grid{grid-template-areas:'photo' 'copy'}.photo img{min-height:280px}.capacity{gap:var(--space-4);padding:var(--space-4)}.cta-strip-inner{align-items:flex-start;flex-direction:column}.cta-strip-buttons{flex-direction:column;width:100%}.cta-strip-buttons .button{width:100%;justify-content:center}}
</style>

