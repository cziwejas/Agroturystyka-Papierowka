---
import BaseLayout from '../layouts/BaseLayout.astro';
import { Image } from 'astro:assets';
import Area from '../components/Area.astro';
import Icon from '../components/Icon.astro';
import LocalFlavors from '../components/LocalFlavors.astro';
import BookingCta from '../components/BookingCta.astro';
import { site } from '../config/site';
import living from '../assets/img/salon.jpg';
import veranda from '../assets/img/altana1.jpg';
---
<BaseLayout title="O nas — Papierówka" description="Poznaj Papierówkę: przestronny dom i zielony teren na spokojny wypoczynek w miejscowości Wasilkowo na Podlasiu.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Nasze miejsce</span><h1>O Papierówce</h1><p>Zapraszamy Was do domu, w którym łatwo złapać oddech i pobyć razem.</p></div></section>
  <section class="section story"><div class="container story-grid"><figure class="photo photo--living"><div class="photo-media"><Image src={living} alt="Jasny salon Papierówki z dużą sofą i drewnianymi schodami" widths={[640, 960, 1280]} sizes="(max-width: 650px) calc(100vw - 66px), (max-width: 1160px) calc(50vw - 64px), 502px" format="webp" loading="lazy"/></div><figcaption><span class="photo-caption-icon"><Icon name="home" size={22} /></span><span class="photo-caption-copy"><small>W domu</small><strong>Przestrzeń do wspólnego odpoczynku</strong></span></figcaption></figure><div class="story-copy"><span class="eyebrow">Dom otwarty na wspólny czas</span><h2>Przyjedźcie, rozgośćcie się, odpocznijcie</h2><p>Zapraszamy Was do Papierówki z rodziną albo z przyjaciółmi. Jest tu miejsce na wspólny obiad, wieczór przy kominku i poranek bez pośpiechu. W przestronnym salonie możecie pobyć razem, pograć w planszówki albo po prostu odpocząć.</p><p>W domu mamy 8–10 miejsc noclegowych, Wi-Fi i klimatyzację na obu piętrach. Z Wasilkowa do Puszczy Białowieskiej jest kilometr, a do Białowieży około 30 km. Możecie więc zaplanować dłuższą wycieczkę albo zostać u nas i cieszyć się spokojem.</p><p>{site.kitchenDescription}</p><dl class="capacity" aria-label="Wielkość domu"><div><dt>Miejsc noclegowych</dt><dd><Icon name="bed" size={24} /><span>8–10</span></dd></div><div><dt>Łazienki</dt><dd><Icon name="bath" size={24} /><span>2</span></dd></div></dl></div></div></section>
  <section class="section outdoor"><div class="container outdoor-grid"><div class="outdoor-copy"><span class="eyebrow">Wypoczynek po swojemu</span><h2>Blisko natury, z miejscem na relaks</h2><p>Możecie przyjechać do nas o każdej porze roku. Pod zadaszoną wiatą czekają sauna i bania, z których możecie korzystać także zimą (dodatkowo płatne). W ogrodzie mamy duży, zarybiony staw — na łowienie ryb, a w ciepłe dni również na kąpiel. Na ognisko możecie wybrać miejsce nad stawem albo przy altanie.</p><ul class="highlights"><li>Kuchnia do Waszej dyspozycji, Wi-Fi i klimatyzacja na obu piętrach</li><li>Pościel i ręczniki zapewnione w cenie pobytu</li><li>Sauna i bania pod zadaszoną wiatą — czynne przez cały rok</li><li>Wiata ogrodowa, grill gazowy i miejsca na ognisko</li><li>Duży, zarybiony staw do wędkowania i kąpieli</li><li>Rowery i spokojne trasy w okolicy</li><li>Placyk zabaw, trampolina i basen w sezonie</li><li>Ogród i ogrodzony teren — zwierzęta mile widziane</li><li>Parking na terenie posesji dla kilku aut</li><li>1 km od Puszczy Białowieskiej — szanse na spotkanie żubrów</li></ul></div><figure class="photo photo--veranda"><div class="photo-media"><Image src={veranda} alt="Zadaszona weranda Papierówki z drewnianym stołem i miejscami do siedzenia" widths={[640, 960, 1280]} sizes="(max-width: 650px) calc(100vw - 66px), (max-width: 1160px) calc(50vw - 64px), 502px" format="webp" loading="lazy"/></div><figcaption><span class="photo-caption-icon"><Icon name="tree" size={22} /></span><span class="photo-caption-copy"><small>Blisko natury</small><strong>Weranda na wspólne chwile</strong></span></figcaption></figure></div></section>
  <LocalFlavors />
  <Area />
  <BookingCta title="Przyjedźcie do Papierówki" />
</BaseLayout>
<style>
  .story{background:var(--color-white)}.story-grid,.outdoor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(var(--space-8),7vw,var(--space-16));align-items:center}
  .photo{margin:0;padding:var(--space-3);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}
  .photo-media{overflow:hidden;aspect-ratio:4/3;border-radius:var(--radius-icon);background:var(--color-soft)}
  .photo--veranda .photo-media{aspect-ratio:4/5}
  .photo img{display:block;width:100%;height:100%;object-fit:cover}
  .photo figcaption{display:flex;align-items:center;gap:var(--space-3);padding:var(--space-5) var(--space-3) var(--space-2)}
  .photo-caption-icon{display:flex;flex:0 0 var(--space-10);width:var(--space-10);height:var(--space-10);align-items:center;justify-content:center;border-radius:var(--radius-pill);background:var(--color-soft);color:var(--color-forest)}
  .photo-caption-copy{display:grid;gap:var(--space-1)}
  .photo-caption-copy small{color:var(--color-forest);font-size:.7rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}
  .photo-caption-copy strong{color:var(--color-ink);font-size:.9rem;font-weight:600;line-height:1.5}
  .story-copy h2,.outdoor-copy h2{margin:var(--space-2) 0 var(--space-4)}.story-copy p,.outdoor-copy p{color:var(--color-muted)}.capacity{--capacity-width:24rem;display:grid;grid-template-columns:repeat(2,minmax(0,1fr));width:min(100%,var(--capacity-width));margin:var(--space-8) 0 0;padding:var(--space-6) 0;border:1px solid var(--color-line);border-radius:var(--radius-icon);background:var(--color-paper)}.capacity>div{display:flex;min-width:0;flex-direction:column;align-items:center;gap:var(--space-2);padding-inline:var(--space-4);text-align:center}.capacity>div+div{border-left:1px solid var(--color-line)}.capacity dt{color:var(--color-muted);font-size:.8rem;font-weight:500;line-height:1.5}.capacity dd{display:flex;order:-1;align-items:center;justify-content:center;gap:var(--space-3);margin:0;color:var(--color-forest-dark);font-family:'Lora',Georgia,serif;font-size:2rem;font-weight:600;line-height:1.2}.capacity :global(svg){flex-shrink:0;color:var(--color-forest)}
  .outdoor{background:var(--color-soft)}.outdoor-grid{grid-template-areas:'copy photo'}.outdoor-copy{grid-area:copy}.photo--veranda{grid-area:photo}.highlights{display:grid;gap:var(--space-3);margin:var(--space-6) 0 0;padding:0;list-style:none}.highlights li{display:flex;align-items:flex-start;gap:var(--space-3);color:var(--color-ink)}.highlights li::before{content:'';flex:0 0 8px;width:8px;height:8px;margin-top:.55em;border-radius:50%;background:var(--color-forest)}
  @media(max-width:850px){.story-grid,.outdoor-grid{gap:var(--space-8)}}
  @media(max-width:650px){.story-grid,.outdoor-grid{grid-template-columns:1fr}.outdoor-grid{grid-template-areas:'photo' 'copy'}.photo--veranda .photo-media{aspect-ratio:4/3}.photo figcaption{padding:var(--space-4) var(--space-1) var(--space-1)}.capacity{margin-top:var(--space-6);padding-block:var(--space-5)}}
</style>

