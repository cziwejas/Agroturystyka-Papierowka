---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
import { Image } from 'astro:assets';
import living from '../assets/img/Papierówka_022.jpg';
import veranda from '../assets/img/Papierówka_045.jpg';
---
<BaseLayout title="O nas — Papierówka" description="Poznaj Papierówkę: przestronny dom i zielony teren na spokojny wypoczynek w miejscowości Wasilkowo na Podlasiu.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Nasze miejsce</span><h1>O Papierówce</h1><p>Dom, w którym łatwo złapać oddech i pobyć razem.</p></div></section>
  <section class="section story"><div class="container story-grid"><figure class="photo photo--living"><Image src={living} alt="Jasny salon Papierówki z dużą sofą i drewnianymi schodami" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy"/><figcaption>Przestrzeń do wspólnego odpoczynku</figcaption></figure><div class="story-copy"><span class="eyebrow">Dom otwarty na wspólny czas</span><h2>Przyjedźcie, rozgośćcie się, odpocznijcie</h2><p>Papierówka to duży dom przygotowany z myślą o rodzinach i grupach. Wspólny posiłek, spokojny wieczór przy kominku czy leniwy poranek — tutaj każdy może złapać własny rytm.</p><p>Wygodnie wypoczywa tu 8 osób, a salon zapewnia dwa dodatkowe miejsca do spania na sofie.</p><div class="capacity"><div><strong>8</strong><span>osób komfortowo</span></div><i aria-hidden="true"></i><div><strong>10</strong><span>miejsc noclegowych</span></div></div></div></div></section>
  <section class="section outdoor"><div class="container outdoor-grid"><div class="outdoor-copy"><span class="eyebrow">Wypoczynek po swojemu</span><h2>Blisko natury, z miejscem na relaks</h2><p>Na zewnątrz czekają zadaszona wiata, grill i ogród. Można wskoczyć na rower, odpocząć na świeżym powietrzu albo skorzystać z dodatkowo płatnej strefy relaksu z sauną i banią.</p><ul class="highlights"><li>Rowery i spokojne trasy w okolicy</li><li>Placyk zabaw, trampolina i basen w sezonie</li><li>Ogrodzony teren — zwierzęta mile widziane</li></ul></div><figure class="photo photo--veranda"><Image src={veranda} alt="Zadaszona weranda Papierówki z drewnianym stołem i miejscami do siedzenia" widths={[640, 960, 1280]} sizes="(max-width: 760px) 100vw, 50vw" format="webp" loading="lazy"/><figcaption>Weranda na wspólne chwile o każdej porze dnia</figcaption></figure></div></section>
  <section class="section pricing"><div class="container"><div class="section-heading"><span class="eyebrow">Przejrzyste ustalenia</span><h2>Ceny i dodatki</h2><p>Ostateczną cenę i szczegóły pobytu ustalamy przed rezerwacją.</p></div><div class="price-grid"><article class="price-card price-card--main"><span class="price-label">Pobyt tygodniowy</span><h3>Dom na wyłączność</h3><p>{site.price}</p></article><article class="price-card"><span class="price-label">Spotkania</span><h3>Wieczory panieńskie i kawalerskie</h3><p>{site.eventPrice}</p></article><article class="price-card"><span class="price-label">Strefa relaksu</span><h3>Sauna i bania</h3><p>{site.relaxationPrice}</p></article></div></div></section>
  <section class="section rules"><div class="container rules-panel"><div><span class="eyebrow">Przed przyjazdem</span><h2>Ważne informacje</h2><p>Jeśli masz pytania dotyczące zasad pobytu, skontaktuj się z nami — chętnie wszystko wyjaśnimy.</p></div><ul><li><span>Przyjazd</span><strong>Zameldowanie od {site.checkIn}</strong></li><li><span>Wyjazd</span><strong>Wymeldowanie do {site.checkOut}</strong></li><li><span>Zwierzęta</span><strong>{site.pets}</strong></li><li><span>Rezerwacja</span><strong>{site.bookingTerms}</strong></li><li><span>Wspólna przestrzeń</span><strong>Prosimy o poszanowanie ciszy nocnej i wyposażenia domu.</strong></li></ul></div></section>
</BaseLayout>
<style>
  .page-hero{padding-block:clamp(var(--space-12),8vw,var(--space-16));background:var(--color-soft) url('/img/forest-mist.svg') center/cover no-repeat}.page-hero h1{margin:var(--space-2) 0}.page-hero p{margin-bottom:0;color:var(--color-muted)}
  .story{background:var(--color-white)}.story-grid,.outdoor-grid{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,1fr);gap:clamp(var(--space-8),7vw,var(--space-16));align-items:center}.photo{position:relative;overflow:hidden;margin:0;border-radius:var(--radius-card);background:var(--color-soft);box-shadow:var(--shadow-card)}.photo img{display:block;width:100%;height:100%;min-height:380px;object-fit:cover}.photo--living img{aspect-ratio:4/3}.photo--veranda img{aspect-ratio:4/3}.photo figcaption{position:absolute;right:0;bottom:0;left:0;padding:var(--space-8) var(--space-6) var(--space-5);background:linear-gradient(transparent,var(--color-gallery-overlay));color:var(--color-white);font-size:.9rem;font-weight:600}
  .story-copy h2,.outdoor-copy h2{margin:var(--space-2) 0 var(--space-4)}.story-copy p,.outdoor-copy p,.section-heading p,.rules-panel p{color:var(--color-muted)}.capacity{display:flex;align-items:center;gap:var(--space-6);margin-top:var(--space-8);padding:var(--space-5) var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-paper)}.capacity>div{display:flex;align-items:center;gap:var(--space-3)}.capacity strong{color:var(--color-forest-dark);font-family:'Lora',Georgia,serif;font-size:2rem;line-height:1}.capacity span{max-width:9ch;color:var(--color-muted);font-size:.85rem;line-height:1.3}.capacity i{width:1px;height:42px;background:var(--color-line)}
  .outdoor{background:var(--color-soft)}.outdoor-grid{grid-template-areas:'copy photo'}.outdoor-copy{grid-area:copy}.photo--veranda{grid-area:photo}.highlights{display:grid;gap:var(--space-3);margin:var(--space-6) 0 0;padding:0;list-style:none}.highlights li{display:flex;align-items:flex-start;gap:var(--space-3);color:var(--color-ink)}.highlights li::before{content:'';flex:0 0 8px;width:8px;height:8px;margin-top:.55em;border-radius:50%;background:var(--color-forest)}
  .pricing{background:var(--color-paper)}.section-heading{max-width:640px;margin-bottom:var(--space-8)}.section-heading h2{margin:var(--space-2) 0}.section-heading p{margin-bottom:0}.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4)}.price-card{display:flex;min-height:220px;flex-direction:column;padding:var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}.price-card--main{border-color:var(--color-forest);background:var(--color-forest-dark);color:var(--color-white)}.price-label{color:var(--color-forest);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.price-card--main .price-label{color:var(--color-muted-on-forest)}.price-card h3{margin:var(--space-3) 0 var(--space-2);font-family:'Lora',Georgia,serif;font-size:1.35rem;font-weight:600}.price-card p{margin:0;color:var(--color-muted)}.price-card--main p{color:var(--color-muted-on-forest)}
  .rules{background:var(--color-white)}.rules-panel{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(var(--space-8),7vw,var(--space-16));padding:clamp(var(--space-6),5vw,var(--space-10));border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-soft)}.rules-panel h2{margin:var(--space-2) 0}.rules-panel p{margin:0}.rules-panel ul{margin:0;padding:0;list-style:none}.rules-panel li{display:grid;grid-template-columns:minmax(100px,.6fr) 1fr;gap:var(--space-4);padding:var(--space-3) 0;border-bottom:1px solid var(--color-line)}.rules-panel li:last-child{border-bottom:0}.rules-panel li span{color:var(--color-muted);font-size:.88rem}.rules-panel li strong{color:var(--color-ink);font-size:.92rem;font-weight:600}
  @media(max-width:850px){.story-grid,.outdoor-grid{gap:var(--space-8)}.price-grid{grid-template-columns:1fr 1fr}.price-card--main{grid-column:1/-1;min-height:unset}.rules-panel{grid-template-columns:1fr;gap:var(--space-6)}}
  @media(max-width:650px){.story-grid,.outdoor-grid{grid-template-columns:1fr}.outdoor-grid{grid-template-areas:'photo' 'copy'}.photo img{min-height:280px}.capacity{gap:var(--space-4);padding:var(--space-4)}.price-grid{grid-template-columns:1fr}.price-card--main{grid-column:auto}.price-card{min-height:unset}.rules-panel li{grid-template-columns:1fr;gap:var(--space-1)}}
</style>
