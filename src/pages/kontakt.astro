---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { site } from '../config/site';
---
<BaseLayout title="Kontakt i rezerwacje — Papierówka" description="Skontaktuj się z Papierówką w sprawie pobytu. Rezerwacje przyjmujemy telefonicznie lub e-mailem.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Jesteśmy do dyspozycji</span><h1>Kontakt</h1><p>Zapytaj o wolny termin i szczegóły pobytu.</p></div></section>
  <section class="section"><div class="container contact-grid"><article class="contact-details"><span class="eyebrow">Kontakt</span><h2>Rezerwacje</h2><p>Rezerwujemy pobyty telefonicznie lub przez e-mail. Napisz albo zadzwoń, a ustalimy dostępność, cenę i szczegóły przyjazdu.</p><div class="contact-method"><strong>Telefon</strong><a class="contact-link" href={site.phoneHref}>{site.phone}</a></div><div class="contact-method"><strong>E-mail</strong><span class="email" data-user={site.emailLocal} data-host={site.emailDomain}></span><noscript><a class="contact-link" href={`mailto:${site.email}`}>{site.email}</a></noscript></div><div class="contact-address"><strong>Adres obiektu</strong><span>{site.address}, {site.postalCode} {site.addressLocality}</span><span>województwo podlaskie</span></div><div class="contact-prices"><strong>Informacje o pobycie</strong><p>{site.price}</p><p>{site.eventPrice}</p><p>{site.relaxationPrice}</p></div></article><article class="map-card"><div class="map-heading"><span class="eyebrow">Dojazd</span><h2>Papierówka na mapie</h2><p>Wasilkowo 6 · 1 km od Puszczy Białowieskiej</p></div><div class="map-embed"><GoogleMap title={`Mapa lokalizacji Papierówki przy adresie ${site.address}, ${site.postalCode} ${site.addressLocality}`} /></div><div class="map-footer"><div><strong>{site.address}</strong><span>{site.postalCode} {site.addressLocality}, woj. podlaskie</span></div><a class="button" href={site.directionsUrl} target="_blank" rel="noopener noreferrer">Wyznacz trasę <span aria-hidden="true">↗</span></a></div></article></div></section>
</BaseLayout>
<style>
  .page-hero{padding-block:clamp(var(--space-12),8vw,var(--space-16));background:var(--color-soft) url('/img/forest-mist.svg') center/cover no-repeat}.page-hero h1{margin:var(--space-2) 0}.page-hero p{margin-bottom:0;color:var(--color-muted)}
  .contact-grid{display:grid;grid-template-columns:minmax(290px,.8fr) minmax(0,1.2fr);gap:var(--space-6);align-items:stretch}
  .contact-grid article{min-width:0;border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}
  .contact-details{padding:clamp(var(--space-6),4vw,var(--space-10))}.contact-details h2{margin:var(--space-2) 0}.contact-details>p{margin-bottom:var(--space-6);color:var(--color-muted)}
  .contact-method,.contact-address,.contact-prices{display:flex;flex-direction:column;gap:var(--space-1);padding-block:var(--space-4);border-top:1px solid var(--color-line)}
  .contact-method strong,.contact-address strong,.contact-prices>strong{font-size:.78rem;letter-spacing:.04em;text-transform:uppercase;color:var(--color-muted)}.contact-link,.email{font-weight:700;color:var(--color-cta);text-underline-offset:4px;overflow-wrap:anywhere}.contact-address span:last-child{color:var(--color-muted);font-size:.9rem}.contact-prices p{margin:0;color:var(--color-muted);font-size:.92rem;line-height:1.55}.contact-prices>strong{margin-bottom:var(--space-1)}
  .map-card{display:grid;grid-template-rows:auto 1fr auto;overflow:hidden;padding:0!important;background:var(--color-white)!important}.map-heading{padding:clamp(var(--space-5),3vw,var(--space-8)) clamp(var(--space-5),3vw,var(--space-8)) var(--space-4)}.map-heading h2{margin:var(--space-2) 0}.map-heading p{margin:0;color:var(--color-muted)}
  :global(.map-embed .map-frame){min-height:340px;height:100%;border:0;border-radius:0;box-shadow:none}:global(.map-embed iframe){min-height:340px;height:100%}
  .map-footer{display:flex;align-items:center;justify-content:space-between;gap:var(--space-4);padding:var(--space-5) clamp(var(--space-5),3vw,var(--space-8));background:var(--color-soft)}.map-footer>div{display:flex;flex-direction:column;line-height:1.5}.map-footer>div span{color:var(--color-muted);font-size:.9rem}.map-footer .button{flex-shrink:0;background:var(--color-forest-dark);box-shadow:none}.map-footer .button:hover{background:var(--color-forest)}
  @media(max-width:760px){.contact-grid{grid-template-columns:1fr}.map-footer{align-items:flex-start;flex-direction:column}.map-footer .button{width:100%}}
</style>
