---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="Kontakt i rezerwacje — Papierówka" description="Skontaktuj się z Papierówką w sprawie pobytu. Rezerwacje przyjmujemy telefonicznie lub e-mailem.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Jesteśmy do dyspozycji</span><h1>Kontakt</h1><p>Zapytaj o wolny termin i szczegóły pobytu.</p></div></section>
  <section class="section"><div class="container contact-grid"><article><h2>Rezerwacje</h2><p>Rezerwujemy pobyty telefonicznie lub przez e-mail. Napisz albo zadzwoń, a ustalimy dostępność, cenę i szczegóły przyjazdu.</p><p><strong>Telefon</strong><br/><a class="contact-link" href={site.phoneHref}>{site.phone}</a></p><p><strong>E-mail</strong><br/><span class="email" data-user={site.emailLocal} data-host={site.emailDomain}>{site.email}</span></p><p><strong>Adres</strong><br/>{site.address}<br/>{site.postalCode} {site.addressLocality}<br/>województwo podlaskie</p><p><strong>Cena za dobę</strong><br/>{site.price}<br/>{site.eventPrice}</p><p><strong>Strefa relaksu</strong><br/>{site.relaxationPrice}</p></article><article class="map-card"><span class="map-icon" aria-hidden="true">⌖</span><h2>Wasilkowo, Podlasie</h2><p>1 km od Puszczy Białowieskiej</p><a class="button" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Otwórz mapę ↗</a><p class="muted">Dokładne wskazówki dojazdu przekażemy przy rezerwacji.</p></article></div></section>
</BaseLayout>
<style>.page-hero{padding:76px 0;background:#e5e9df}.page-hero h1{font-size:clamp(2.5rem,6vw,4rem);margin:.5rem 0}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:2rem}.contact-grid article{background:#fff;padding:clamp(1.5rem,4vw,2.5rem);border-radius:var(--radius);box-shadow:var(--shadow)}.contact-link,.email{font-weight:700;color:#ba4214}.map-card{background:#e9ede5!important;text-align:center;display:flex;flex-direction:column;align-items:center;justify-content:center}.map-icon{font-size:3rem;color:var(--green)}.map-card p:last-child{font-size:.85rem;margin-top:1.5rem}@media(max-width:650px){.contact-grid{grid-template-columns:1fr}}</style>
