---
import BaseLayout from '../layouts/BaseLayout.astro';
import GoogleMap from '../components/GoogleMap.astro';
import { site } from '../config/site';
---
<BaseLayout title="Kontakt i rezerwacje — Papierówka" description="Skontaktuj się z Papierówką w sprawie pobytu. Rezerwacje przyjmujemy telefonicznie lub e-mailem.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Jesteśmy do dyspozycji</span><h1>Kontakt</h1><p>Zapytaj o wolny termin i szczegóły pobytu.</p></div></section>
  <section class="section"><div class="container contact-grid"><article><h2>Rezerwacje</h2><p>Rezerwujemy pobyty telefonicznie lub przez e-mail. Napisz albo zadzwoń, a ustalimy dostępność, cenę i szczegóły przyjazdu.</p><p><strong>Telefon</strong><br/><a class="contact-link" href={site.phoneHref}>{site.phone}</a></p><p><strong>E-mail</strong><br/><span class="email" data-user={site.emailLocal} data-host={site.emailDomain}>{site.email}</span></p><p><strong>Adres</strong><br/>{site.address}<br/>{site.postalCode} {site.addressLocality}<br/>województwo podlaskie</p><p><strong>Cena za dobę</strong><br/>{site.price}<br/>{site.eventPrice}</p><p><strong>Strefa relaksu</strong><br/>{site.relaxationPrice}</p></article><article class="map-card"><span class="eyebrow">Dojazd</span><h2>Wasilkowo, Podlasie</h2><p>1 km od Puszczy Białowieskiej</p><GoogleMap title={`Mapa lokalizacji Papierówki przy adresie ${site.address}, ${site.postalCode} ${site.addressLocality}`} /><a class="button" href={site.mapUrl} target="_blank" rel="noopener noreferrer">Wyznacz trasę ↗</a><p class="muted">Dokładne wskazówki dojazdu przekażemy przy rezerwacji.</p></article></div></section>
</BaseLayout>
<style>.page-hero{padding-block:clamp(var(--space-12),8vw,var(--space-16));background:var(--color-soft)}.page-hero h1{margin:var(--space-2) 0}.page-hero p{margin-bottom:0;color:var(--color-muted)}.contact-grid{display:grid;grid-template-columns:1fr 1fr;gap:var(--space-6);align-items:stretch}.contact-grid article{padding:clamp(var(--space-6),4vw,var(--space-10));border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}.contact-grid article p{overflow-wrap:anywhere}.contact-link,.email{font-weight:700;color:var(--color-cta);text-underline-offset:4px}.map-card{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:var(--space-2);background:var(--color-soft)!important;text-align:center}.map-card h2{margin:0}.map-card .map-frame{width:100%;margin-block:var(--space-3)}.map-card>p:last-child{margin-top:var(--space-3);font-size:.85rem}@media(max-width:650px){.contact-grid{grid-template-columns:1fr}}</style>
