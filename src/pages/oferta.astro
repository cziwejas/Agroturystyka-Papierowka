---
import BaseLayout from '../layouts/BaseLayout.astro';
import { site } from '../config/site';
---
<BaseLayout title="Oferta i ceny — Papierówka" description="Sprawdź ofertę Papierówki: pobyt w domu na wyłączność, ceny, dodatki i ważne informacje przed przyjazdem.">
  <section class="page-hero"><div class="container"><span class="eyebrow">Pobyt w Papierówce</span><h1>Oferta</h1><p>Sprawdź ceny, dodatki i najważniejsze informacje przed przyjazdem.</p></div></section>
  <section class="section pricing"><div class="container"><div class="section-heading"><span class="eyebrow">Przejrzyste ustalenia</span><h2>Ceny i dodatki</h2><p>Ostateczną cenę i szczegóły pobytu ustalamy przed rezerwacją.</p></div><div class="price-grid"><article class="price-card price-card--main"><span class="price-label">Pobyt tygodniowy</span><h3>Dom na wyłączność</h3><p>{site.price}</p></article><article class="price-card"><span class="price-label">Spotkania</span><h3>Wieczory panieńskie i kawalerskie</h3><p>{site.eventPrice}</p></article><article class="price-card"><span class="price-label">Strefa relaksu</span><h3>Sauna i bania</h3><p>{site.relaxationPrice}</p></article></div></div></section>
  <section class="section rules"><div class="container rules-panel"><div><span class="eyebrow">Przed przyjazdem</span><h2>Ważne informacje</h2><p>Jeśli masz pytania dotyczące zasad pobytu, skontaktuj się z nami — chętnie wszystko wyjaśnimy.</p></div><ul><li><span>Przyjazd</span><strong>Zameldowanie od {site.checkIn}</strong></li><li><span>Wyjazd</span><strong>Wymeldowanie do {site.checkOut}</strong></li><li><span>Zwierzęta</span><strong>{site.pets}</strong></li><li><span>Rezerwacja</span><strong>{site.bookingTerms}</strong></li><li><span>Wspólna przestrzeń</span><strong>Prosimy o poszanowanie ciszy nocnej i wyposażenia domu.</strong></li></ul></div></section>
</BaseLayout>
<style>
  .pricing{background:var(--color-white)}.section-heading{max-width:640px;margin-bottom:var(--space-8)}.section-heading h2{margin:var(--space-2) 0}.section-heading p{margin-bottom:0;color:var(--color-muted)}.price-grid{display:grid;grid-template-columns:repeat(3,minmax(0,1fr));gap:var(--space-4)}.price-card{display:flex;min-height:220px;flex-direction:column;padding:var(--space-6);border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-white);box-shadow:var(--shadow-card)}.price-card--main{border-color:var(--color-forest);background:var(--color-forest-dark);color:var(--color-white)}.price-label{color:var(--color-forest);font-size:.75rem;font-weight:700;letter-spacing:.1em;text-transform:uppercase}.price-card--main .price-label{color:var(--color-muted-on-forest)}.price-card h3{margin:var(--space-3) 0 var(--space-2);font-family:'Lora',Georgia,serif;font-size:1.35rem;font-weight:600}.price-card p{margin:0;color:var(--color-muted)}.price-card--main p{color:var(--color-muted-on-forest)}
  .rules{background:var(--color-paper)}.rules-panel{display:grid;grid-template-columns:.8fr 1.2fr;gap:clamp(var(--space-8),7vw,var(--space-16));padding:clamp(var(--space-6),5vw,var(--space-10));border:1px solid var(--color-line);border-radius:var(--radius-card);background:var(--color-soft)}.rules-panel h2{margin:var(--space-2) 0}.rules-panel p{margin:0;color:var(--color-muted)}.rules-panel ul{margin:0;padding:0;list-style:none}.rules-panel li{display:grid;grid-template-columns:minmax(100px,.6fr) 1fr;gap:var(--space-4);padding:var(--space-3) 0;border-bottom:1px solid var(--color-line)}.rules-panel li:last-child{border-bottom:0}.rules-panel li span{color:var(--color-muted);font-size:.88rem}.rules-panel li strong{color:var(--color-ink);font-size:.92rem;font-weight:600}
  @media(max-width:850px){.price-grid{grid-template-columns:1fr 1fr}.price-card--main{grid-column:1/-1;min-height:unset}.rules-panel{grid-template-columns:1fr;gap:var(--space-6)}}
  @media(max-width:650px){.price-grid{grid-template-columns:1fr}.price-card--main{grid-column:auto}.price-card{min-height:unset}.rules-panel li{grid-template-columns:1fr;gap:var(--space-1)}}
</style>

