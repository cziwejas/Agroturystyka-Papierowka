---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="Nie znaleziono strony — Papierówka" description="Podana strona nie istnieje.">
  <section class="not-found"><span class="eyebrow">Błąd 404</span><h1>Tu nic nie rośnie</h1><p>Nie znaleźliśmy tej strony. Wróć na stronę główną Papierówki.</p><a class="button" href="/">Strona główna</a></section>
</BaseLayout>
<style>.not-found{display:flex;min-height:55vh;flex-direction:column;align-items:center;justify-content:center;padding:var(--space-12) var(--space-4);text-align:center}.not-found p{color:var(--color-muted)}</style>
